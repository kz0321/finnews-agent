# DeepSeek OpenAI-compatible endpoint. No OpenAI account required.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Optional: needed only for live web collection, not imported-source research.
TAVILY_API_KEY=
# Optional pricing, USD per million tokens. Leave blank if not known.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
# Storage stays local and is excluded from Git.
FINNEWS_DATA_DIR=runtime
# Token counter: bytes is network-free and conservative. For real experiments,
# use cl100k consistently across B0/B1/B2 (first use downloads tiktoken encoding).
FINNEWS_TOKEN_COUNTER=bytes
